{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:display_context",
    "on_true": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        { "when": ["ITEM_HAND_FIRST_PERSON", "ITEM_HAND_THIRD_PERSON"], "model": { "type": "minecraft:model", "model": "catframe:item/bluey" } }
      ],
      "fallback": { "type": "minecraft:model", "model": "catframe:item/bluey" }
    },
    "on_false": { "type": "minecraft:model", "model": "catframe:item/bluey" }
  }
}
