{
  "model": {
    "type": "minecraft:select",
    "property": "catframe:meta",
    "fallback": { "type": "minecraft:model", "model": "minecraft:item/fish" },
    "cases": [
      {"when": "0", "model": { "type": "minecraft:model", "model": "minecraft:item/fish" }},
      {"when": "1", "model": { "type": "minecraft:model", "model": "minecraft:item/fish_salmon_raw" }},
      {"when": "2", "model": { "type": "minecraft:model", "model": "minecraft:item/fish_clownfish" }},
      {"when": "3", "model": { "type": "minecraft:model", "model": "minecraft:item/fish_pufferfish" }}
    ]
  }
}
